# A stand-in remote development box: sshd, a couple of "dev servers" that
# appear after autotun has already connected, and every port-listing tool the
# prober knows how to fall back through.
#
# AUTOTUN_HIDE (runtime env) removes tools from the image so the prober is
# forced down its fallback chain — that is how the e2e suite exercises the
# netstat and /proc parsers against real output rather than fixtures.
FROM debian:stable-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      openssh-server \
      iproute2 \
      net-tools \
      lsof \
      procps \
      python3 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /run/sshd \
    && useradd -m -s /bin/bash dev \
    && passwd -d dev

# Key-only authentication; the key is generated by the caller and mounted at
# /keys, so no private key is ever baked into this image.
RUN sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config \
    && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config \
    # A developer's agent can hold well over the default six keys, and every
    # one it offers counts as an attempt before the matching key is reached.
    && sed -i 's/^#*MaxAuthTries.*/MaxAuthTries 50/' /etc/ssh/sshd_config

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY devserver.py /usr/local/bin/devserver.py
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 22
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
